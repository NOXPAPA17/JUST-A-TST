local function isGood(name, size)     -- is this file already saved with the right size?
    if not isfile then return false end
    local okF, exists = pcall(isfile, name)
    if not (okF and exists) then return false end
    if not readfile then return true end
    local okR, cur = pcall(readfile, name)
    return okR and type(cur) == "string" and #cur == size
end

-- writes a file once; later runs reuse it (faster start). A cached file of the wrong size is rewritten.
local function ensureFile(name, b64, size)
    if not isGood(name, size) then
        writefile(name, b64decode(b64, 4000))
        if readfile then
            local okR, cur = pcall(readfile, name)
            if okR and type(cur) == "string" and #cur ~= size then
                warn("[NOX] " .. name .. ": saved " .. #cur .. " of " .. size .. " bytes (this executor mangles binary files)")
                if notify then notify("Executor can't save binary files.") end
            end
        end
    end
    return getAsset(name)
end

local function makeLabel(ed, n, asset)   -- one picture-sheet label, sized to COVER the window (extra is clipped)
    local holderW, holderH = WIN_W - 8, WIN_H - 8
    local scale = math.max(holderW / ed.fw, holderH / ed.fh)
    local l = Instance.new("ImageLabel")
    l.Name = "Sheet" .. n
    l.AnchorPoint = Vector2.new(0.5, 0.5)
    l.Position = UDim2.fromScale(0.5, 0.5)
    l.Size = UDim2.fromOffset(math.ceil(ed.fw * scale), math.ceil(ed.fh * scale))
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.Active = false
    l.ImageTransparency = 1                       -- hidden until it is this sheet's turn
    l.ImageRectSize = Vector2.new(ed.fw, ed.fh)
    l.ZIndex = 1
    l.Image = asset
    l.Parent = wallHolder
    return l
end

local function loadEdit(ed, token)
    local layers = {}
    for n = 1, ed.sheetCount do
        if loadToken ~= token then
            for _, l in pairs(layers) do pcall(function() l:Destroy() end) end
            return
        end
        local ok, err = pcall(function()
            local file = "nox_" .. ed.id .. "_s" .. n .. ".jpg"
            local asset
            if ed.fromFiles then                  -- edit installed by a pack script
                if isfile and not isGood(file, ed.sheetSizes[n]) then
                    error("file missing - run the pack script for this edit again")
                end
                asset = getAsset(file)
            else                                  -- edit stored inside this script
                asset = ensureFile(file, ed.sheets[n], ed.sheetSizes[n])
            end
            layers[n] = makeLabel(ed, n, asset)
        end)
        if not ok then warn("[NOX] sheet " .. n .. " failed: " .. tostring(err)) end
        notify("Loading " .. ed.name .. " " .. n .. "/" .. ed.sheetCount .. "...")
    end
    if loadToken ~= token then
        for _, l in pairs(layers) do pcall(function() l:Destroy() end) end
        return
    end
    wallLayers = layers

    local okM, errM = pcall(function()
        local file = "nox_" .. ed.id .. "_music.mp3"
        if ed.fromFiles then
            if isfile and not isGood(file, ed.musicSize) then error("song file missing - run the pack script again") end
            sound.SoundId = getAsset(file)
        else
            sound.SoundId = ensureFile(file, ed.music, ed.musicSize)
        end
    end)
    if not okM then warn("[NOX] music failed: " .. tostring(errM)) end
    musicOk = okM

    -- wait (max 15s) until the pictures and the song are ready
    local t0 = tick()
    while tick() - t0 < 15 and loadToken == token do
        local ready = true
        for _, l in pairs(layers) do
            local a, v = pcall(function() return l.IsLoaded end)
            if a and not v then ready = false end
        end
        if okM then
            local b, m = pcall(function() return sound.IsLoaded end)
            if b and not m then ready = false end
        end
        if ready then break end
        task.wait(0.2)
    end
    if loadToken ~= token then return end

    -- START the edit and its song together
    playStart = tick()
    mediaReady = true
    syncMusic()
    local anyLoaded = false
    for _, l in pairs(layers) do
        local a, v = pcall(function() return l.IsLoaded end)
        if a and v then anyLoaded = true end
    end
    if anyLoaded then
        notify(ed.name .. " playing.")
    else
        notify("Edit images did not load - see console.")
        warn("[NOX] the picture sheets did not load (getcustomasset returned something Roblox could not read)")
    end
end

-- switch the background: window shape + picture frames + song
local function selectEdit(i)
    local ed = EDITS[i]
    if not ed then return end
    loadToken = loadToken + 1
    local token = loadToken
    currentEdit = i
    E = ed
    playStart = nil
    mediaReady = false
    musicOk = false
    lastFrame, lastSheet, lastT = -1, nil, 0
    pcall(function() sound:Stop() end)
    for _, l in pairs(wallLayers) do pcall(function() l:Destroy() end) end
    wallLayers = {}
    if refreshEditButtons then refreshEditButtons() end
    pcall(function() if writefile then writefile("nox_bg_choice.txt", ed.id) end end)

    local sz = ed.win[IS_MOBILE and "mobile" or "pc"]
    setWindowSize(sz[1], sz[2])

    if not (getAsset and writefile) then
        warn("[NOX] executor has no getcustomasset/writefile - cannot load the edit")
        notify("Executor can't load the edit.")
        return
    end
    notify("Loading " .. ed.name .. "...")

    task.spawn(function()
        local ok, err = pcall(loadEdit, ed, token)
        if not ok then
            warn("[NOX] " .. ed.name .. " failed: " .. tostring(err))
            notify(ed.name .. " failed - see console.")
        end
    end)
end

-- frame player: cheap, only touches the screen when the frame changes
RunService.Heartbeat:Connect(function()
    if not (playStart and E) or not main.Visible then return end
    local T = clock()
    if T < lastT - 1 then syncMusic() end                -- the edit looped: restart the song in step
    lastT = T
    local frame = math.floor(T * E.fps) % E.frames
    if frame == lastFrame then return end
    lastFrame = frame
    local sheet = math.floor(frame / E.per) + 1
    local idx = frame % E.per
    local layer = wallLayers[sheet]
    if not layer then return end
    layer.ImageRectOffset = Vector2.new((idx % E.cols) * E.fw, math.floor(idx / E.cols) * E.fh)
    if sheet ~= lastSheet then
        if lastSheet and wallLayers[lastSheet] then wallLayers[lastSheet].ImageTransparency = 1 end
        layer.ImageTransparency = 0
        lastSheet = sheet
    end
end)

-- keep the song locked to the edit (fixes any drift)
task.spawn(function()
    while gui.Parent do
        task.wait(1)
        if musicOn and musicOk and playStart and E then
            pcall(function()
                local d = math.abs(sound.TimePosition - clock())
                d = math.min(d, E.duration - d)
                if d > 0.3 or not sound.IsPlaying then syncMusic() end
            end)
        end
    end
end)

