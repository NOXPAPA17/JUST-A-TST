    -- run a script from a link, in the background (never freezes the GUI)
    local function runRemote(url, name)
        url = url:gsub("^https://pastebin%.com/(%w+)$", "https://pastebin.com/raw/%1")
        notify("Loading " .. name .. "...")
        task.spawn(function()
            local ok, err = pcall(function()
                local fn, perr = loadstring(game:HttpGet(url))
                if not fn then error(perr) end
                fn()
            end)
            if ok then
                notify(name .. " loaded.")
            else
                notify("Could not load " .. name .. ".")
                warn("[NOX] " .. name .. " failed: " .. tostring(err))
            end
        end)
    end

