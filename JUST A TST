-- edits installed by pack scripts (saved on the device): read their info file and add a button
local function parseInfo(text)
    local kv = {}
    for k, v in text:gmatch("([%w_]+)=([^\r\n]*)") do kv[k] = v end
    local function num(k) return tonumber(kv[k]) end
    local function pair(k, dw, dh)
        local a, b = (kv[k] or ""):match("^(%d+),(%d+)$")
        if a then return {tonumber(a), tonumber(b)} end
        return {dw, dh}
    end
    local sizes = {}
    for s in (kv.sheetSizes or ""):gmatch("%d+") do sizes[#sizes + 1] = tonumber(s) end
    if not (kv.name and num("fps") and num("fw") and num("fh") and num("cols") and num("per")
            and num("frames") and num("musicSize") and #sizes > 0) then
        return nil
    end
    return {
        name = kv.name, fps = num("fps"), fw = num("fw"), fh = num("fh"), cols = num("cols"),
        per = num("per"), frames = num("frames"), musicSize = num("musicSize"),
        sheetSizes = sizes, sheetCount = #sizes, fromFiles = true,
        win = {pc = pair("winpc", 420, 525), mobile = pair("winmobile", 330, 412)},
    }
end

local function scanPacks()
    local added = 0
    if not (isfile and readfile) then return 0 end
    for _, pid in ipairs(PACK_IDS) do
        local known = false
        for _, ed in ipairs(EDITS) do if ed.id == pid then known = true end end
        if not known then
            local infoFile = "nox_" .. pid .. "_info.txt"
            local okF, exists = pcall(isfile, infoFile)
            if okF and exists then
                local okR, txt = pcall(readfile, infoFile)
                local ed = okR and type(txt) == "string" and parseInfo(txt)
                if ed then
                    ed.id = pid
                    ed.duration = ed.frames / ed.fps
                    EDITS[#EDITS + 1] = ed
                    addEditButton(#EDITS)
                    added = added + 1
                end
            end
        end
    end
    refreshEditButtons()
    return added
end

